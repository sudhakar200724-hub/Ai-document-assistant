# AI Document Intelligence & Learning Assistant - Environment Configuration

# Choose your AI provider: 'gemini', 'openai', 'groq', or 'demo' (default: demo mode if keys are empty)
LLM_PROVIDER=demo
FORCE_DEMO_MODE=false

# Google Gemini API Key (recommended: https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API Key (optional: https://platform.openai.com/)
OPENAI_API_KEY=

# Groq API Key (optional: https://console.groq.com/)
GROQ_API_KEY=

# Maximum document upload size in megabytes
MAX_UPLOAD_SIZE_MB=25

# RAG Chunking parameters (tokens/words)
CHUNK_SIZE=650
CHUNK_OVERLAP=120

# Host and Port settings
PORT=8000
HOST=127.0.0.1
